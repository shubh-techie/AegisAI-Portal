---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import CreatorProfile from "../../components/CreatorProfile.astro";
import HackathonNav from "../../components/HackathonNav.astro";
import { keynote, speakers, judges, statusDefinitions } from "../../data/hackathons";
---
<Layout title="Hackathon Community" description="Meet the AegisAI creator and explore planned keynote, guest speaker and independent judge roles for the community hackathon program.">
  <Hero eyebrow="Community / People" title="Engineering grows through exchange." description="A planned space for practitioners and researchers to share methods, critique evidence and improve secure distributed systems." />
  <div class="container page-content"><HackathonNav />
    <section class="section" aria-labelledby="keynote-heading"><span class="program-status">{keynote.status}</span><h2 id="keynote-heading">Keynote Speaker</h2><p>{keynote.person.name} is the creator and maintainer of AegisAI and the planned program keynote speaker. Talk topic and schedule are pending.</p><CreatorProfile /></section>
    {[{title: "Guest Speakers", slots: speakers, note: "Three future guest speaker slots. No guest speakers have been announced or marked invited."}, {title: "Judges", slots: judges, note: "Independent judges are planned. No appointments or invitations are claimed; selection and conflict-of-interest procedures are pending."}].map(group => <section class="section"><h2>{group.title}</h2><p>{group.note}</p><div class="cards-grid three">{group.slots.map(slot => <article class="info-card"><span class="program-status">{slot.status}</span><h3>{slot.person?.name ?? slot.label}</h3><p>{slot.person?.role ?? "Person to be announced. This is a planned role, not a confirmed participant."}</p>{slot.person?.profileUrl && <a class="text-link" href={slot.person.profileUrl}>Verified profile</a>}</article>)}</div></section>)}
    <section class="section"><h2>Participants</h2><p>Participation is free and registration is not open yet. No participant roster, attendance counts or submissions are announced.</p></section>
    <section class="section"><h2>Community Partners</h2><p>Community collaboration is planned. No partners or sponsors have been confirmed or announced.</p></section>
    <section class="notice"><h2>Reading program status</h2><dl class="program-status-guide">{Object.entries(statusDefinitions).map(([status, meaning]) => <><dt>{status}</dt><dd>{meaning}</dd></>)}</dl><p>All current event and future-role entries are PLANNED. No completed events or winners are claimed.</p></section>
  </div>
</Layout>
