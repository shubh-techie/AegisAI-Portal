---
import { hackathonSeo, hackathonSocialPreview } from "../../data/hackathonSeo";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import HackathonNav from "../../components/HackathonNav.astro";
import EventDetails from "../../components/hackathons/EventDetails.astro";
import { events } from "../../data/hackathons";
---
<Layout title={hackathonSeo.events.title} description={hackathonSeo.events.description} socialImage={hackathonSocialPreview.image}>
  <Hero eyebrow="Community / Events" title="Three ways to challenge the system." description="Build, evaluate and document security ideas with reproducible evidence. All events are planned; exact dates and official terms are pending." />
  <div class="container page-content"><HackathonNav />
    {events.map((event, index) => <EventDetails event={event} index={index}/>)}
  </div>
</Layout>
