---
import { creator } from '../../data/creator';
import { asset } from '../../data/project';
---
<aside class="speaker-profile" aria-label="Speaker profile">
  <img src={asset(creator.photo.path)} alt={creator.photo.alt} width="72" height="72" loading="lazy" decoding="async"/>
  <div><h2>{creator.name}</h2><p>{creator.role} · {creator.projectDesignation}</p><p>{creator.researchFocus}</p><a class="text-link" href={creator.website}>aeglysai.com →</a></div>
</aside>
<style>
  .speaker-profile { display: flex; gap: 20px; align-items: flex-start; border-top: 1px solid var(--line); padding-top: 24px; margin-top: 32px; }
  img { border-radius: 6px; object-fit: cover; width: 72px; height: 72px; flex-shrink: 0; }
  h2 { margin: 0 0 8px; font-size: 1.1rem; }
  p { color: var(--muted); margin: 0 0 8px; line-height: 1.7; }
  a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 390px) { .speaker-profile { flex-direction: column; } }
</style>
