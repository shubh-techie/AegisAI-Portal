---
import { asset } from "../../data/project";
import { formatPublicationDate, type MediaArticle } from "../../data/media";
interface Props { article: MediaArticle; compact?: boolean; }
const { article, compact = false } = Astro.props;
---
<article class:list={["info-card", "media-card", { "media-card-compact": compact }]} data-media-id={article.id}>
  <div class="media-image">
    <div class="media-placeholder" aria-hidden="true"><img src={asset("brand/icons/icon-mark.png")} alt="" width="64" height="64"/><span>AeglysAI</span><small>Media Coverage</small></div>
    {article.thumbnail && <img class="media-thumbnail" src={article.thumbnail.path.startsWith("https://") ? article.thumbnail.path : asset(article.thumbnail.path)} alt={article.thumbnail.alt} width="800" height="450" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.setAttribute('hidden', '')"/>}
  </div>
  <div class="media-body">
  <div class="media-source">
    <div><p class="media-publication">{article.publication}</p>{article.publishedDate ? <time datetime={article.publishedDate}>{formatPublicationDate(article.publishedDate)}</time> : <p class="media-review">Publication date: manual review pending</p>}</div>
  </div>
  <h3>{article.title}</h3>
  {!compact && <><p class="media-category">{article.category}</p><p>{article.summary}</p></>}
  {!article.titleVerified && <p class="media-review">Headline supplied; source verification pending.</p>}
  <a class="text-link media-read" href={article.url} target="_blank" rel="noopener noreferrer">Read Article <span aria-hidden="true">→</span><span class="sr-only">: {article.title} ({article.publication}; opens in a new tab)</span></a>
</div>
</article>
<style>
  .media-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; min-width: 0; overflow-wrap: anywhere; }
  .media-source { display: flex; align-items: center; gap: 14px; }
  .media-image { position: relative; aspect-ratio: 16 / 9; background: var(--surface-raised); overflow: hidden; }
  .media-thumbnail { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .media-thumbnail[hidden] { display: none; }
  .media-placeholder { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--cyan); background: radial-gradient(ellipse at top right, var(--line), transparent 70%); }
  .media-placeholder img { border-radius: 10px; width: 48px; height: 48px; }
  .media-placeholder span { font-size: 1.2rem; font-weight: 650; }
  .media-placeholder small { color: var(--muted); }
  .media-body { padding: 24px; flex: 1; display: flex; flex-direction: column; }
  .media-card h3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  .media-source .media-publication { color: var(--text); font-weight: 650; font-size: 0.95rem; line-height: 1.4; margin: 0 0 5px; }
  .media-source time, .media-review { color: var(--muted); font-size: 0.78rem; line-height: 1.5; }
  .media-card h3 { font-size: 1.18rem; line-height: 1.5; margin: 24px 0 16px; }
  .media-card .media-category { color: var(--cyan); font-size: 0.75rem; line-height: 1.6; margin-bottom: 14px; }
  .media-read { margin-top: auto; padding-top: 24px; min-height: 44px; display: inline-block; line-height: 1.6; font-size: 0.84rem; }
  .media-card-compact h3 { font-size: 1rem; }
</style>
