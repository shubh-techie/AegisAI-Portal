---
import type { SocialImage } from "../data/hackathonSeo";
import ThemeInit from "../components/ThemeInit.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { creator } from "../data/creator";
import { project, asset } from "../data/project";
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  socialImage?: SocialImage | null;
}
const {
  title,
  description = project.description,
  noindex = false,
  socialImage = null,
} = Astro.props;
const fullTitle = `${title} | AegisAI Research`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = socialImage ? new URL(asset(socialImage.path), Astro.site) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#080f1c" />
    <ThemeInit />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={creator.name} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AegisAI Research" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && socialImageUrl && <>
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={socialImage.alt} />
      <meta property="og:image:width" content={String(socialImage.width)} />
      <meta property="og:image:height" content={String(socialImage.height)} />
      <meta name="twitter:image" content={socialImageUrl} />
      <meta name="twitter:image:alt" content={socialImage.alt} />
    </>}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
