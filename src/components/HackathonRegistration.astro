---
import { registrationLinks } from "../data/hackathons";
interface Props { url?: string | null; id?: string; kind?: "participant" | "judge"; }
const kind = Astro.props.kind ?? "participant";
const id = Astro.props.id ?? `${kind}-registration-note`;
const url = Astro.props.url ?? registrationLinks[kind];
const label = kind === "judge" ? "Apply to Judge" : "Register for Hackathon";
const note = kind === "judge"
  ? "Judge applications are not open yet. The official application form will be linked here when available."
  : "Participant registration is not open yet. The official registration form will be linked here when available.";
---
{url ? <a class="button button-primary" href={url}>{label}</a> : <div class="registration-placeholder"><button class="button" disabled aria-describedby={id}>{label}</button><p id={id}>Opening Soon. {note}</p></div>}
