---
import { asset } from '../../data/project';
import type { Presentation } from '../../data/presentations';
interface Props { presentation: Presentation; }
const { presentation } = Astro.props;
const pdf = presentation.pdf;
if (!pdf) throw new Error("PDF viewer requires an approved PDF");
const pdfUrl = asset(pdf.path);
---
<section class="pdf-section" aria-labelledby="slides-heading">
  <h2 id="slides-heading">Presentation slides</h2>
  <p class="pdf-fallback">If the preview doesn’t open, use the PDF link below.</p>
  <div class="pdf-actions">
    <a class="button" href={pdfUrl} target="_blank" rel="noopener noreferrer">Open PDF <span aria-hidden="true">↗</span><span class="sr-only">: {presentation.title} (opens in a new tab)</span></a>
    {pdf.downloadEnabled && <a class="button button-outline" href={pdfUrl} download>Download PDF<span class="sr-only">: {presentation.title}</span></a>}
  </div>
  <iframe class="presentation-pdf-viewer" src={`${pdfUrl}#view=FitH`} title={`PDF slides: ${presentation.title}`} loading="lazy" width="100%" height="640"></iframe>
</section>
<style>
  .pdf-section { margin-top: 36px; }
  .pdf-fallback { color: var(--muted); margin: 16px 0; line-height: 1.7; }
  .pdf-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  .presentation-pdf-viewer { display: block; width: 100%; height: 70vh; min-height: 420px; max-height: 850px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface-raised); }
  @media (max-width: 639px) { .presentation-pdf-viewer { height: 60vh; min-height: 360px; } }
</style>
