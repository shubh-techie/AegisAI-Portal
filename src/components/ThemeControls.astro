<div class="theme-controls" role="group" aria-label="Color theme">
  <button class="theme-button" data-theme-toggle hidden type="button" aria-label="Switch color theme">
    <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
    <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/></svg>
  </button>
  <button class="theme-button" data-theme-system hidden type="button" aria-label="Use system theme" aria-pressed="true" title="Use system theme">
