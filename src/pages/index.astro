---
import Layout from "../layouts/Layout.astro";
import ModelCard from "../components/ModelCard.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { project, models, href } from "../data/project";
---

<Layout title="Adaptive Intelligence for Secure Distributed Systems">
  <section class="home-hero container">
    <div class="hero-copy">
      <div class="eyebrow hero-kicker">
        <span class="live-dot" aria-hidden="true"></span>Open-source research
        initiative
      </div>
      <h1>
        Aegis<span>AI</span>
        <span class="hero-fullname">{project.fullName}</span>
      </h1>
      <p class="tagline">{project.tagline}</p>
      <p class="hero-description">{project.description}</p>
      <div class="actions">
        <a class="button button-primary" href={href("research")}>
          Explore Research <span aria-hidden="true">→</span>
        </a>
        <a
          class="button"
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub ↗<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <div class="research-visual">
      <div class="visual-top">
        <span class="eyebrow">Authorization / evolving</span>
        <span class="visual-code">A → D</span>
      </div>
      <svg
        viewBox="0 0 420 330"
        role="img"
        aria-labelledby="hero-diagram-title hero-diagram-description"
      >
        <title id="hero-diagram-title">From deterministic policies to adaptive authorization</title>
        <desc id="hero-diagram-description">
          Solid cyan layers represent implemented Models A, B and C. A dashed
          amber outer layer represents planned Model D.
        </desc>
        <defs>
          <pattern
            id="dots"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="1" cy="1" r="1" fill="#294052" />
          </pattern>
        </defs>
        <rect width="420" height="330" fill="url(#dots)" />
        <g fill="none" stroke-width="1.5">
          <path
            d="M210 23 377 113v106L210 309 43 219V113Z"
            stroke="#e9bb75"
            stroke-dasharray="5 6"
          />
          <path d="m210 62 130 72v66l-130 71-130-71v-66Z" stroke="#487387" />
          <path d="m210 99 94 51v37l-94 51-94-51v-37Z" stroke="#6b8dc6" />
          <path
            d="m210 131 56 31v19l-56 30-56-30v-19Z"
            stroke="#64e1ed"
            fill="#102a37"
          />
          <path
            d="M210 23v108M377 219l-111-38M43 219l111-38"
            stroke="#395063"
          />
        </g>
        <g font-family="monospace" text-anchor="middle">
          <text x="210" y="178" fill="#eaf6fb" font-size="15">
            POLICY
          </text>
          <text x="210" y="54" fill="#e9bb75" font-size="11">
            D / PLANNED
          </text>
          <text x="321" y="235" fill="#a8bfd0" font-size="11">
            C
          </text>
          <text x="281" y="211" fill="#aabff4" font-size="11">
            B
          </text>
          <text x="248" y="184" fill="#64e1ed" font-size="11">
            A
          </text>
        </g>
        <g fill="#64e1ed">
          <circle cx="210" cy="131" r="4" />
          <circle cx="266" cy="181" r="4" />
          <circle cx="154" cy="181" r="4" />
        </g>
      </svg>
      <div class="visual-bottom">
        <span class="eyebrow">The research direction</span>
        <p>
          From explicit rules.
          <br />
          <strong>Toward bounded adaptation.</strong>
        </p>
        <span class="microcopy">Conceptual progression · Model D planned</span>
      </div>
    </div>
  </section>
  <div class="theme-band">
    <div class="container">
      <span class="eyebrow">Research theme</span>
      <p>{project.theme}</p>
    </div>
  </div>
  <section class="section container">
    <div class="section-heading-row">
      <SectionHeading
        eyebrow="01 / Research progression"
        title="A baseline for every next step."
        description="Three implemented authorization models establish the foundation for a planned behavioral research model."
      />
      <a class="text-link" href={href("research")}>
        Explore the models <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="models-grid">
      {models.map((model) => (
        <ModelCard model={model} />
      ))}
    </div>
  </section>
  <section class="section container architecture-section">
    <SectionHeading
      eyebrow="02 / System perspective"
      title="Evidence in. Explainable decisions out."
      description="Investigating how identity, context, behavior and system state can inform authorization within explicit policy boundaries."
    />
    <ArchitectureDiagram />
  </section>
  <section class="section container question-section">
    <div>
      <span class="eyebrow">03 / The central question</span>
      <h2>What changes when authorization can adapt?</h2>
    </div>
    <div>
      <p class="question-copy">{project.question}</p>
      <a class="text-link" href={href("experiments")}>
        Toward reproducible experiments <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="container closing-panel">
    <div>
      <span class="eyebrow">Work in the open</span>
      <h2>Follow the research as it develops.</h2>
      <p>
        Research plans, architecture and work in preparation. Evidence will lead
        the conclusions.
      </p>
    </div>
    <a class="button" href={href("about")}>
      About & Roadmap <span aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
