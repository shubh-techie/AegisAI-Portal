---
import { href } from '../../data/project';
import { speakingView, formatPresentationDate, type Presentation } from '../../data/presentations';
interface Props { presentation: Presentation; featured?: boolean; }
const { presentation, featured = false } = Astro.props;
const view = speakingView(presentation);
---
<article class:list={['engagement-card', { 'featured-engagement': featured }]} data-engagement-status={view.status}>
  <div class="engagement-copy">
    <p class="eyebrow">{view.series ?? 'Speaking engagement'} · {view.role}</p>
    <p class="engagement-badge">{presentation.participationNote ?? (view.status === 'Invited' ? 'Invitation received — participation not yet confirmed' : view.status)}</p>
    <h3>{view.eventName} <span class="event-acronym">({presentation.conference?.shortName})</span></h3>
    <p class="engagement-date">{view.eventDate && <><time datetime={view.eventDate.start}>{formatPresentationDate(view.eventDate.start)}</time> – <time datetime={view.eventDate.end}>{formatPresentationDate(view.eventDate.end)}</time></>}{view.location && <> · {view.location}</>}</p>
    <p class="engagement-description">{presentation.description}</p>
  </div>
  <div class="engagement-details">
    <dl><div><dt>Talk title</dt><dd>{view.talkTitle ?? 'To be confirmed'}</dd></div><div><dt>Organizer</dt><dd>{view.organizer ?? 'To be confirmed'}</dd></div><div><dt>Speaker</dt><dd>{presentation.speaker}</dd></div><div><dt>Slides</dt><dd>{view.slidesUrl ? 'Available' : 'Not yet available'}</dd></div></dl>
    <a class="text-link event-link" href={view.externalEventUrl!} target="_blank" rel="noopener noreferrer">Conference website ↗<span class="sr-only">: {presentation.conference?.shortName} (opens in a new tab)</span></a>
    <a class="text-link" href={href(`speaking/${view.id}`)}>View Engagement <span aria-hidden="true">→</span><span class="sr-only">: {view.eventName}</span></a>
  </div>
</article>
<style>
  .engagement-card { padding: 28px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); display: flex; flex-direction: column; gap: 24px; height: 100%; overflow-wrap: anywhere; transition: border-color .18s ease; }
  .engagement-card:hover { border-color: var(--accent-border); }
  .engagement-copy > p { margin: 0 0 16px; }
  h3 { font-size: 1.5rem; line-height: 1.4; margin: 16px 0; }
  .engagement-badge { display: inline-block; padding: 8px 12px; border: 1px solid var(--accent-border); border-radius: 4px; background: var(--implemented-bg); color: var(--cyan); font-size: .8rem; line-height: 1.5; }
  .engagement-date, .engagement-description { color: var(--muted); line-height: 1.7; }
  .event-acronym { font-size: .8em; color: var(--muted); }
  .event-link { margin-right: 16px; }
  .engagement-details { margin-top: auto; }
  dl { margin: 0 0 20px; display: grid; gap: 14px; }
  dt { color: var(--muted); font-size: .75rem; margin-bottom: 4px; }
  dd { margin: 0; line-height: 1.6; }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; }
  .featured-engagement { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); padding: 36px; gap: 40px; border-top: 3px solid var(--cyan); }
  .featured-engagement h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .featured-engagement .engagement-details { margin-top: 0; padding-left: 32px; border-left: 1px solid var(--line); }
  @media (max-width: 767px) { .engagement-card { padding: 24px; } .featured-engagement { grid-template-columns: 1fr; gap: 24px; } .featured-engagement .engagement-details { padding: 24px 0 0; border-left: 0; border-top: 1px solid var(--line); } }
  @media (prefers-reduced-motion: reduce) { .engagement-card { transition: none; } }
</style>
